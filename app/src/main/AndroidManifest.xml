<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Android 10 and older have no "all files access": creating the Novel
         folder there needs ordinary write permission. Not used on 11+. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:ignore="ScopedStorage" />

    <!-- For PlaybackService (background audio playback + the system
         media notification). FOREGROUND_SERVICE_MEDIA_PLAYBACK is the
         Android 14+ typed foreground-service permission; POST_NOTIFICATIONS
         is required on Android 13+ for the notification to actually show
         (requested at runtime — see MainActivity's onCreate). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- "Download songs": the yt-dlp that is bundled in this app (SongDownloader.kt) fetches
         songs from the internet. Nothing else in the app uses the network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- In-app updates (AppUpdater.kt): REQUEST_INSTALL_PACKAGES lets the app install the APK it
         downloaded from GitHub (the user still allows "install unknown apps" for it once and
         confirms each install); ACCESS_NETWORK_STATE lets it skip the automatic download on mobile data. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- "Fetch new chapters" and "Delete chapters" run the Python scripts in
         assets/scripts inside Termux (ChapterTools.kt). Termux's RUN_COMMAND
         permission is a runtime permission: the app asks for it the first time. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- Required on Android 11+ to be able to see Termux by package name
         (package visibility restrictions) so ChapterTools can check that it is
         installed and send it the RUN_COMMAND intent (the song downloader no
         longer needs Termux). -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:allowBackup="true"
        android:requestLegacyExternalStorage="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.NovelReader"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.NovelReader">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hosts the real ExoPlayer instance + MediaSession — see
             PlaybackService.kt. android:exported="true" plus the
             MediaSessionService intent-filter is what lets Media3's own
             MediaController (and the system's notification/lock-screen
             controller) bind to it. -->
        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>
