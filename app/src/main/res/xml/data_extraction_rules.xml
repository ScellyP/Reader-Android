<?xml version="1.0" encoding="utf-8"?>
<!-- Same exclusions for Android 12 and newer (android:dataExtractionRules),
     for both cloud backup and device-to-device transfer. See backup_rules.xml
     for what each line covers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="moon_unlock.xml" />
        <exclude domain="root" path="app_webview" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="moon_unlock.xml" />
        <exclude domain="root" path="app_webview" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
