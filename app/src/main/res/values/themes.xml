<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- windowBackground is what Android paints from the instant the app
         is tapped until the first WebView frame. Without it the system
         default (often white) flashes before the dark UI appears. -->
    <style name="Theme.NovelReader" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
